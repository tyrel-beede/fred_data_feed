  "events": {
   "skill": "dials-gather",
   "due_weekdays": [
    "Mon",
    "Tue",
    "Wed",
    "Thu",
    "Fri",
    "Sat"
   ],
   "release": "daily",
   "tolerance_days": 2,
   "note": "raw date-gated hits for the event sweep: pulled/downsized deals, gated funds, capex cuts/deferrals/digestion, re-priced rounds, LTA renegotiations, GW deferrals, auction tails, sovereign stress. Hits only — scoring is the orchestrator's."
  },
  "standoff": {
   "skill": "dials-gather",
   "due_weekdays": [
    "Mon",
    "Tue",
    "Wed",
    "Thu",
    "Fri",
    "Sat"
   ],
   "release": "daily (oil settles ~14:30 ET; UKMTO/press continuous)",
   "tolerance_days": 2,
   "feeds": [
    "standoff-watch T/M/O panels",
    "macro-dials B1-oil, Hormuz fork"
   ],
   "sources": [
    "settles: Brent front and second month, WTI front (cappnotes closing look, tradingeconomics)",
    "Dated Brent / physical premium (press: Argus, Reuters)",
    "Hormuz transits per day and tanker counts (Lloyd's List, Kpler, Windward via press; straits.live daily brief)",
    "UKMTO / JMIC incident advisories (count and type, dated)",
    "war-risk insurance premia (press)",
    "political plumbing: talks, mediators, IAEA, sanctions, strike reports (Reuters, AP, dated)"
   ],
   "note": "readings and dated headlines only; no tell scoring, no branch weights - standoff-watch does that"
  }
