{
 "_about": "Configuration for the macro-dials sub-skills (dials-voices, dials-gather). Edited here, never hard-coded in a skill. Times are America/Boise. Weekdays: Mon..Sun. tolerance_days = how old a group's as_of may be at a macro-dials run before it is 'carried'.",
 "version": "2026-11-06b",
 "timezone": "America/Boise",
 "repo": "tyrel-beede/fred_data_feed",
 "output_root": "dials",
 "schedules": {
  "dials-voices": {
   "weekdays": [
    "Mon",
    "Thu"
   ],
   "time": "04:48",
   "note": "Substack and newsletter posts cluster Tue/Wed and Fri; Monday catches the weekend essays, Thursday the mid-week ones."
  },
  "dials-gather": {
   "weekdays": [
    "Mon",
    "Tue",
    "Wed",
    "Thu",
    "Fri",
    "Sat"
   ],
   "time": "05:10",
   "note": "Runs daily; which groups it gathers is decided by due_weekdays below. Saturday exists for the Friday-afternoon releases (CFTC 15:30 ET, H.8, Flow Show). The standoff group is gathered on every firing; the oil settles it records are the prior session's."
  },
  "dials-weekly": {
   "weekdays": [
    "Sat"
   ],
   "time": "06:10",
   "sequence": [
    "standoff-watch",
    "macro-dials",
    "macro-column"
   ],
   "note": "One session, one writer: standoff run folder -> dials run folder -> column file and post. Runs after the 05:10 Saturday gather. A failed stage stops the later ones; partial lets the next stage carry the previous output, labeled."
  }
 },
